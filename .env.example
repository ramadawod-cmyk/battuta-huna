ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Unsplash Access Key -- powers city hero photos (cityHero.ts via unsplash-image.js). Kept
# server-side (no VITE_ prefix) since Unsplash bills/rate-limits per request; the client never
# sees this key, only the resolved photo URL. Set this in both Netlify sites' environment
# variables (staging and production), not just here. Falls back to Wikipedia when unset.
UNSPLASH_ACCESS_KEY=
# Viator affiliate partner ID (pid) -- not secret, it's meant to appear in public URLs. Exposed to
# the client bundle (VITE_ prefix) since it's only ever used to build a link, never called from a
# server context. Same value for staging and production (one affiliate account, not per-environment).
VITE_VIATOR_PID=
# Geoapify API key -- powers reverse geocoding (geo.ts). No longer used for map tiles --
# TripMapBuilder.tsx moved to Google Maps, see VITE_GOOGLE_MAPS_KEY below. Exposed to the client
# bundle (VITE_ prefix) since Geoapify's security model is a per-key domain/referrer restriction
# set in their dashboard, not secrecy. Falls back to OpenStreetMap's/Nominatim's public servers
# when unset, which is fine for local dev but not for a deployed site under real traffic. Set this
# in both Netlify sites' environment variables (staging and production), not just here.
VITE_GEOAPIFY_KEY=
# Google Maps Platform -- powers the trip map (TripMapBuilder.tsx) only, not any Places/POI data
# (the app's own AI-generated site/activity data is used for markers). Exposed to the client
# bundle (VITE_ prefix) since Google's security model is a per-key HTTP-referrer restriction set
# in Cloud Console, not secrecy -- restrict it to battutahuna.com/staging.battutahuna.com/
# localhost before shipping. Without a key, TripMapBuilder shows a "map unavailable" placeholder
# instead of crashing. VITE_GOOGLE_MAPS_ID is a Map ID (Cloud Console > Map Management, JavaScript
# platform) required for Advanced Markers to render -- falls back to Google's public DEMO_MAP_ID
# for local dev, but a real one is required before this goes live. Set both in both Netlify sites'
# environment variables (staging and production), not just here.
VITE_GOOGLE_MAPS_KEY=
VITE_GOOGLE_MAPS_ID=
