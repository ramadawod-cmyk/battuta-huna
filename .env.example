ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Viator affiliate partner ID (pid) -- not secret, it's meant to appear in public URLs. Exposed to
# the client bundle (VITE_ prefix) since it's only ever used to build a link, never called from a
# server context. Same value for staging and production (one affiliate account, not per-environment).
VITE_VIATOR_PID=
# Geoapify API key -- powers map tiles (TripMapBuilder.tsx) and reverse geocoding (geo.ts).
# Exposed to the client bundle (VITE_ prefix) since Geoapify's security model is a per-key
# domain/referrer restriction set in their dashboard, not secrecy. Falls back to OpenStreetMap's/
# Nominatim's public servers when unset, which is fine for local dev but not for a deployed site
# under real traffic. Set this in both Netlify sites' environment variables (staging and
# production), not just here.
VITE_GEOAPIFY_KEY=
